# Settings for deploy.sh. Copy to deploy.env (which git ignores) and fill in.

# The domain (registered in Route 53, with its hosted zone). www.<domain> is served too.
DOMAIN=nogglebox.com

# S3 bucket that holds the site. Must be globally unique; it's created if missing.
BUCKET=nogglebox-site

# AWS region for the bucket. us-east-1 is simplest (CloudFront certificates live there anyway).
REGION=us-east-1

# AWS CLI profile to use (leave empty for your default credentials).
AWS_PROFILE=

# Optional: email a warning if the month's AWS bill passes 80% of this many US dollars.
# Leave BUDGET_EMAIL empty to skip.
BUDGET_EMAIL=
BUDGET_USD=5
