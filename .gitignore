*.crt
*.cer
*.csr
id_rsa*
id_ed25519*

# Anything explicitly named as secret
secrets/
*secret*
*.secrets
*token*.json
service-account*.json

# Personal / machine-specific Claude Code settings
.claude/settings.local.json

# ---------- Local-only tools and source material ----------
# Sound It Out: raw voice recordings and the script that processes them stay on this computer;
